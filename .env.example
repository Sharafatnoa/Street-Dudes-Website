# Street Dudes - Environment Variables Template
# Copy this file to .env.local for local development

# Google Maps Embed API Key
# To obtain a key:
# 1. Go to Google Cloud Console (https://console.cloud.google.com)
# 2. Create or select a project
# 3. Enable the "Maps Embed API" for your project
# 4. Generate an API Key under Credentials
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Supabase — get from supabase.com project settings
NEXT_PUBLIC_SUPABASE_URL=          # Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Public anon key
SUPABASE_SERVICE_ROLE_KEY=         # Secret service key (server only)

# Google Maps — server-side geocoding (not NEXT_PUBLIC)
GOOGLE_MAPS_GEOCODING_KEY=         # Separate from the embed key

# PIN Protection — choose your own values
KITCHEN_PIN=                       # Sam uses this for kitchen dashboard
ADMIN_PIN=                         # Yasha uses this for admin config
